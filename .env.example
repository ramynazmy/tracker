# Copy to .env.local for development. Both values are PUBLIC identifiers, not
# secrets — see plan.md §6. .env.production is committed on purpose.
#
# Spreadsheet ID: the middle part of the Sheet URL
#   docs.google.com/spreadsheets/d/<THIS>/edit
VITE_SPREADSHEET_ID=

# OAuth client ID from Google Cloud → Credentials, ends in .apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Optional. Only deep-links the Users page runbook to the right Cloud project;
# the links still work without it, they just make you pick the project.
VITE_GCP_PROJECT_ID=
